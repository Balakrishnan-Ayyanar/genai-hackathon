{
  "name": "clauselens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:hmem": "tsx vendor/hmem/conformance/runner.ts",
    "verify": "tsx scripts/verify.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "test:browser": "playwright test",
    "verify:semantic": "tsx scripts/semantic/verify.ts",
    "semantic:generate": "tsx scripts/semantic/generate.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
